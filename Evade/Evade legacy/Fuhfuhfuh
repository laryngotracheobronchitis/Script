local function dummyNetworkSimulation()
    local packets = {}
    for i = 1, 100 do
        packets[i] = {
            id = i,
            data = string.rep(tostring(math.random(0, 9)), math.random(10, 50)),
            timestamp = os.time() + math.random(-100, 100),
            priority = math.random(1, 5)
        }
    end
    
    local function sortPacketByPriority(pktList)
        table.sort(pktList, function(a, b)
            if a.priority == b.priority then
                return a.timestamp < b.timestamp
            end
            return a.priority > b.priority
        end)
        return pktList
    end
    
    local sortedPackets = sortPacketByPriority(packets)
    
    local function processPackets(pktList)
        local processed = {}
        for _, pkt in ipairs(pktList) do
            local hash = 0
            for i = 1, #pkt.data do
                local char = string.sub(pkt.data, i, i)
                hash = (hash * 37 + string.byte(char)) % 2^32
            end
            processed[#processed + 1] = {
                originalId = pkt.id,
                hashValue = hash,
                size = #pkt.data
            }
        end
        return processed
    end
    
    return processPackets(sortedPackets)
end

