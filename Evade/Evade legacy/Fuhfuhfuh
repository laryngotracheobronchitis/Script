        local a, b, c, d = 1, 2, 3, 4
        for i = 1, 100 do
            a = (a * b + c) % d
            b = (b * c + a) % d
            c = (c * a + b) % d
            d = (d * b + c) % a
            if a == 0 then a = 1 end
            if b == 0 then b = 1 end
            if c == 0 then c = 1 end
            if d == 0 then d = 1 end
            table.insert(noise, math.sin(a) * math.cos(b) * math.tan(c) / d)
        end
        return noise
    end
    
