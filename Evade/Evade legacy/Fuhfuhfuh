local function advancedDummyEncryption()
    local key = "KX7mP9qR2sT5vY8wB3dF6gH1jL4nP7"
    local function simpleHash(input)
        local hash = 0
        for i = 1, #input do
            hash = (hash * 31 + string.byte(input, i)) % 2^32
        end
        return hash
    end
    
    local function dummyCrypt(input, mode)
        local result = ""
        for i = 1, #input do
            local charByte = string.byte(input, i)
            local keyByte = string.byte(key, ((i-1) % #key) + 1)
            local encrypted
            if mode == "encrypt" then
                encrypted = charByte + keyByte
            else
                encrypted = charByte - keyByte
            end
            result = result .. string.char(encrypted % 256)
        end
        return result
    end
    
    local testData = "This is a test string for encryption purposes only"
    local encrypted = dummyCrypt(testData, "encrypt")
    local decrypted = dummyCrypt(encrypted, "decrypt")
    
    return {hash = simpleHash(testData), encrypted = encrypted, verified = (testData == decrypted)}
end

