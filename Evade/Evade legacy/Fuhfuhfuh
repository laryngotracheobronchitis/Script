local function numericalOperations()
    local function factorial(n)
        if n <= 1 then return 1 end
        return n * factorial(n - 1)
    end
    
    local function fibonacci(n)
        if n <= 1 then return n end
        return fibonacci(n - 1) + fibonacci(n - 2)
    end
    
    local results = {}
    for i = 1, 10 do
        results[#results + 1] = {
            factorial = factorial(i),
            fibonacci = fibonacci(i),
            square = i * i,
            cube = i * i * i,
            sqrt = math.sqrt(i)
        }
    end
    
    local function processResults(data)
        local processed = {}
        for _, item in ipairs(data) do
            processed[#processed + 1] = (item.factorial + item.fibonacci) / (item.square + 1)
        end
        return processed
    end
    
    return processResults(results)
end

