-- Anti-Cheat Bypass
local getinfo = getinfo or debug.getinfo
pcall(function()
    setthreadidentity(2)
    local Detected, Kill
    for i, v in getgc(true) do
        if typeof(v) == "table" then
            local D = rawget(v, "Detected")
            local K = rawget(v, "Kill")
            if typeof(D) == "function" and not Detected then
                Detected = D
                hookfunction(D, function() return true end)
            end
            if rawget(v, "Variables") and rawget(v, "Process") and typeof(K) == "function" and not Kill then
                Kill = K
                hookfunction(K, function() end)
            end
        end
    end
    pcall(function()
        hookfunction(getrenv().debug.info, newcclosure(function(...)
            if Detected and (...) == Detected then
                return coroutine.yield(coroutine.running())
            end
            return getinfo(...)
        end))
    end)
    setthreadidentity(7)
end)

