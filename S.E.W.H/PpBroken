local function clampPos(pos, objSize)
    local vp = workspace.CurrentCamera.ViewportSize
    return UDim2.new(0, math.clamp(pos.X.Offset, 0, vp.X - objSize.X), 0, math.clamp(pos.Y.Offset, 0, vp.Y - objSize.Y))
end

local function unfreezeFakeTab()
