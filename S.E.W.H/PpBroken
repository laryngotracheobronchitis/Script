-- ========== EXCALIBUR ==========
local ExcaliburConfig = { ESPEnabled = false, AutoTeleport = false }
local trackedExcaliburSpot = nil
local excaliburLoop = nil
local autoTeleportLoop = nil

local function getExcaliburSpot()
    local ss = workspace:FindFirstChild("SwordSpot")
    if ss then local v = ss:FindFirstChild("Visual") if v and v:IsA("BasePart") then return v end end
    return nil
end

local function getExcaliburPrompt()
    local ss = workspace:FindFirstChild("SwordSpot")
    if ss then local pp = ss:FindFirstChild("PromptPart") if pp then local p = pp:FindFirstChild("Prompt") if p and p:IsA("ProximityPrompt") then return p end end end
    return nil
end

local function fireExcaliburPrompt()
    local p = getExcaliburPrompt()
    if not p then return false end
    if pcall(function() if fireproximityprompt then fireproximityprompt(p) end end) then return true end
    if pcall(function() p:Fire() end) then return true end
    return pcall(function() p:InputHoldBegin() task.wait(0.05) p:InputHoldEnd() end)
end

local function teleportAndFireExcalibur()
    local spot = getExcaliburSpot()
    if not spot then return false end
    local c = LocalPlayer.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = CFrame.new(spot.Position + Vector3.new(0, 3, 0))
    task.wait(0.1)
    fireExcaliburPrompt()
    return true
end

local function startAutoTeleportAndPull()
    if autoTeleportLoop then return end
    autoTeleportLoop = task.spawn(function()
        while ExcaliburConfig.AutoTeleport and ExcaliburConfig.ESPEnabled do
            pcall(teleportAndFireExcalibur)
            task.wait(0.3)
        end
    end)
end

local function stopAutoTeleportAndPull()
    if autoTeleportLoop then task.cancel(autoTeleportLoop) autoTeleportLoop = nil end
end

