    end
    FakeTabState.Frozen = false
    FakeTabState.SavedCFrame = nil
    if FakeTabState.IconLabel then FakeTabState.IconLabel.Text = "\u{23F8}\u{FE0F}" end
    if FakeTabState.StatusLabel then
        FakeTabState.StatusLabel.Text = "OFF"
