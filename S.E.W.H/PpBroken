local function setupHealthCheck()
    if autoRejoinConnection then
        autoRejoinConnection:Disconnect()
        autoRejoinConnection = nil
    end
    if not AutoRejoinConfig.Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local hum = character:FindFirstChild("Humanoid")
    if not hum then return end
    if hum.Health < AutoRejoinConfig.HealthThreshold and hum.Health > 0 then
        doRejoin()
        return
    end
    autoRejoinConnection = hum.HealthChanged:Connect(function(health)
        if AutoRejoinConfig.Enabled and health < AutoRejoinConfig.HealthThreshold and health > 0 then
            doRejoin()
        end
    end)
end

