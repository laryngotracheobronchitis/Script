-- ========== PLAYER ESP ==========
local PlayerESPConfig = {
    Enabled = false,
    NormalColor = Color3.fromRGB(255, 255, 255),
    ExcaliburHeldColor = Color3.fromRGB(255, 50, 50),
    ExcaliburBackpackColor = Color3.fromRGB(255, 165, 0),
    MurderColor = Color3.fromRGB(255, 0, 0),
    SheriffColor = Color3.fromRGB(0, 100, 255),
    Tracer = false,
    TracerThickness = 1,
    Highlight = false,
    HighlightFillTransparency = 0.5,
    Distance = false,
    Box2D = false,
    Box2DThickness = 1,
    Box3D = false,
    Box3DTransparency = 0.5
}
local trackedPlayerESP = {}
local playerESPLoop = nil

local function hasExcaliburTool(player)
    if not player or player == LocalPlayer then return nil end
    local ch = player.Character
    if ch and ch:FindFirstChild("Excalibur") then return "held" end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild("Excalibur") then return "backpack" end
    return nil
end

local function isMurder(player)
    if not player or player == LocalPlayer then return false end
    local ch = player.Character
    if ch and ch:FindFirstChild("Knife") then return true end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild("Knife") then return true end
    return false
end

local function isSheriff(player)
    if not player or player == LocalPlayer then return false end
    local cw = workspace:FindFirstChild(player.Name)
    if cw and cw:FindFirstChild("Revolver") then return true end
    local ch = player.Character
    if ch and ch:FindFirstChild("Revolver") then return true end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild("Revolver") then return true end
    return false
end

local function getPlayerRole(player)
    local e = hasExcaliburTool(player)
    if e then return "excalibur_" .. e end
    if isMurder(player) then return "murder" end
    if isSheriff(player) then return "sheriff" end
    return "normal"
end

local function getRoleText(role, name)
    if role == "excalibur_held" then return name .. " [EXCALIBUR HELD]" end
    if role == "excalibur_backpack" then return name .. " [EXCALIBUR BAG]" end
    if role == "murder" then return name .. " [MURDER]" end
    if role == "sheriff" then return name .. " [SHERIFF]" end
    return name
end

local function getRoleColor(role)
    if role == "excalibur_held" then return PlayerESPConfig.ExcaliburHeldColor end
    if role == "excalibur_backpack" then return PlayerESPConfig.ExcaliburBackpackColor end
    if role == "murder" then return PlayerESPConfig.MurderColor end
    if role == "sheriff" then return PlayerESPConfig.SheriffColor end
    return PlayerESPConfig.NormalColor
end

local function isAnyVisualEnabled()
    return PlayerESPConfig.Tracer or PlayerESPConfig.Highlight or PlayerESPConfig.Distance or PlayerESPConfig.Box2D or PlayerESPConfig.Box3D
end

local function createPlayerESP(player)
    if trackedPlayerESP[player] then return end
    local ch = player.Character
    if not ch then return end
    local head = ch:FindFirstChild("Head")
    if not head then return end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local role = getPlayerRole(player)
    local color = getRoleColor(role)
    local data = { currentRole = role, head = head, hrp = hrp, char = ch }
    data.billboard = Instance.new("BillboardGui")
    data.billboard.Name = "ESP_Player"
    data.billboard.Size = UDim2.new(0, 300, 0, 40)
    data.billboard.AlwaysOnTop = true
    data.billboard.StudsOffset = Vector3.new(0, GlobalConfig.VerticalOffset + 1, 0)
    data.billboard.Enabled = PlayerESPConfig.Enabled
    data.billboard.Parent = head
    data.nameLabel = Instance.new("TextLabel")
    data.nameLabel.Size = UDim2.new(1, 0, 1, 0)
    data.nameLabel.BackgroundTransparency = 1
    data.nameLabel.Text = getRoleText(role, player.Name)
    data.nameLabel.TextColor3 = color
    data.nameLabel.TextSize = GlobalConfig.TextSize + 1
    data.nameLabel.Font = Enum.Font.SourceSansBold
    data.nameLabel.TextStrokeTransparency = 0.3
    data.nameLabel.TextXAlignment = Enum.TextXAlignment.Center
    data.nameLabel.Parent = data.billboard
    if HasDrawing then
        pcall(function()
            data.tracer = Drawing.new("Line")
            data.tracer.Thickness = PlayerESPConfig.TracerThickness
            data.tracer.Transparency = 1
            data.tracer.Visible = false
            data.tracer.Color = color
        end)
        pcall(function()
            data.distText = Drawing.new("Text")
            data.distText.Size = 14
            data.distText.Center = true
            data.distText.Outline = true
            data.distText.OutlineColor = Color3.new(0, 0, 0)
            data.distText.Color = color
            data.distText.Visible = false
            data.distText.Font = 2
        end)
        pcall(function()
            data.box2d = Drawing.new("Square")
            data.box2d.Thickness = PlayerESPConfig.Box2DThickness
            data.box2d.Transparency = 1
            data.box2d.Filled = false
            data.box2d.Color = color
            data.box2d.Visible = false
        end)
    end
    data.highlight = Instance.new("Highlight")
    data.highlight.FillTransparency = PlayerESPConfig.HighlightFillTransparency
    data.highlight.OutlineTransparency = 0
    data.highlight.FillColor = color
    data.highlight.OutlineColor = Color3.new(0, 0, 0)
    data.highlight.Enabled = false
    data.highlight.Parent = ch
    data.box3d = Instance.new("SelectionBox")
    data.box3d.Adornee = hrp
    data.box3d.Color3 = color
    data.box3d.LineThickness = 0.05
    data.box3d.Transparency = PlayerESPConfig.Box3DTransparency
    data.box3d.Visible = false
    data.box3d.Parent = ch
    trackedPlayerESP[player] = data
end

local function removePlayerESP(player)
    local d = trackedPlayerESP[player]
    if d then
        if d.tracer then pcall(function() d.tracer:Remove() end) end
        if d.distText then pcall(function() d.distText:Remove() end) end
        if d.box2d then pcall(function() d.box2d:Remove() end) end
        if d.highlight then pcall(function() d.highlight:Destroy() end) end
        if d.box3d then pcall(function() d.box3d:Destroy() end) end
        if d.billboard then pcall(function() d.billboard:Destroy() end) end
        trackedPlayerESP[player] = nil
    end
end

local function refreshPlayerESPColors()
    for _, d in pairs(trackedPlayerESP) do
        local c = getRoleColor(d.currentRole)
        pcall(function() d.nameLabel.TextColor3 = c end)
        if d.tracer then pcall(function() d.tracer.Color = c end) end
        if d.distText then pcall(function() d.distText.Color = c end) end
        if d.box2d then pcall(function() d.box2d.Color = c end) end
        if d.highlight then pcall(function() d.highlight.FillColor = c end) end
        if d.box3d then pcall(function() d.box3d.Color3 = c end) end
    end
end

local function updatePlayerESP()
    local localHrp = LocalPlayer.Character
    if localHrp then localHrp = localHrp:FindFirstChild("HumanoidRootPart") end
    local screenSize = Camera.ViewportSize
    local screenBottom = Vector2.new(screenSize.X / 2, screenSize.Y)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local ch = player.Character
            local head = nil
            local hrp = nil
            if ch then
                head = ch:FindFirstChild("Head")
                hrp = ch:FindFirstChild("HumanoidRootPart")
            end
            if not ch or not head or not hrp then
                removePlayerESP(player)
            else
                local d = trackedPlayerESP[player]
                if not d then
                    if PlayerESPConfig.Enabled or isAnyVisualEnabled() then
                        createPlayerESP(player)
                        d = trackedPlayerESP[player]
                    end
                end
                if d then
                    if d.char ~= ch then
                        removePlayerESP(player)
                        createPlayerESP(player)
                        d = trackedPlayerESP[player]
                    end
                    if d then
                        d.head = head
                        d.hrp = hrp
                        d.char = ch
                        local role = getPlayerRole(player)
                        local color = getRoleColor(role)
                        local dist = 0
                        if localHrp then dist = (localHrp.Position - hrp.Position).Magnitude end
                        if d.currentRole ~= role then
                            d.currentRole = role
                            d.nameLabel.Text = getRoleText(role, player.Name)
                        end
                        d.nameLabel.TextColor3 = color
                        d.billboard.Enabled = PlayerESPConfig.Enabled
                        d.billboard.StudsOffset = Vector3.new(0, GlobalConfig.VerticalOffset + 1, 0)
                        d.nameLabel.TextSize = GlobalConfig.TextSize + 1
                        local headSP, onScreen = Camera:WorldToScreenPoint(head.Position)
                        local vis = onScreen and headSP.Z > 0
                        if d.tracer then
                            d.tracer.Visible = PlayerESPConfig.Tracer and vis
                            if PlayerESPConfig.Tracer and vis then
                                d.tracer.From = screenBottom
                                d.tracer.To = Vector2.new(headSP.X, headSP.Y)
                                d.tracer.Color = color
                                d.tracer.Thickness = PlayerESPConfig.TracerThickness
                            end
                        end
                        if d.distText then
                            d.distText.Visible = PlayerESPConfig.Distance and vis
                            if PlayerESPConfig.Distance and vis then
                                d.distText.Position = Vector2.new(headSP.X, headSP.Y - 25)
                                d.distText.Text = math.floor(dist) .. "m"
                                d.distText.Color = color
                            end
                        end
                        if d.box2d then
                            d.box2d.Visible = PlayerESPConfig.Box2D and vis
                            if PlayerESPConfig.Box2D and vis then
                                local size = hrp.Size
                                local cf = hrp.CFrame
                                local sx = size.X / 2
                                local sy = size.Y / 2
                                local sz = size.Z / 2
                                local corners = {
                                    cf * CFrame.new(sx, sy, sz),
                                    cf * CFrame.new(-sx, sy, sz),
                                    cf * CFrame.new(sx, -sy, sz),
                                    cf * CFrame.new(sx, sy, -sz),
                                    cf * CFrame.new(-sx, -sy, sz),
                                    cf * CFrame.new(sx, -sy, -sz),
                                    cf * CFrame.new(-sx, sy, -sz),
                                    cf * CFrame.new(-sx, -sy, -sz)
                                }
                                local minX = math.huge
                                local minY = math.huge
                                local maxX = -math.huge
                                local maxY = -math.huge
                                for _, c in ipairs(corners) do
                                    local s, o = Camera:WorldToScreenPoint(c.Position)
                                    if o then
                                        if s.X < minX then minX = s.X end
                                        if s.Y < minY then minY = s.Y end
                                        if s.X > maxX then maxX = s.X end
                                        if s.Y > maxY then maxY = s.Y end
                                    end
                                end
                                if maxX > minX and maxY > minY then
                                    d.box2d.Position = Vector2.new(minX, minY)
                                    d.box2d.Size = Vector2.new(maxX - minX, maxY - minY)
                                    d.box2d.Color = color
