-- Utility Functions
local function isBeam(obj)
    if not obj then return false end
    local n = string.lower(obj.Name or "")
    if string.find(n, "beam") then return true end
    return false
end

local function isTripmineWithMesh(obj)
    if not obj then return false end
    local n = string.lower(obj.Name or "")
    if not string.find(n, "tripmine") and not string.find(n, "trip") and not string.find(n, "mine") then return false end
    if obj:IsA("Model") then
        local m = obj:FindFirstChildWhichIsA("MeshPart")
        if m then return true end
    end
    return false
end

local function getAttachPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        local m = obj:FindFirstChildWhichIsA("MeshPart")
        if m then return m end
        local b = obj:FindFirstChildWhichIsA("BasePart")
        if b then return b end
    end
    return nil
end

