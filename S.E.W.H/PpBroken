-- ========== PLACEABLES ESP ==========
local PlaceablesConfig = { ESPEnabled = false, Color = Color3.fromRGB(0, 255, 0) }
local trackedPlaceables = {}
local placeablesLoop = nil

local function isValidForPlaceables(obj)
    if not obj or isBeam(obj) then return false end
    local n = string.lower(obj.Name or "")
    if string.find(n, "tripmine") or string.find(n, "trip") or string.find(n, "mine") then return isTripmineWithMesh(obj) end
    if obj:IsA("Model") then return obj:FindFirstChildWhichIsA("BasePart") ~= nil end
    return obj:IsA("BasePart")
end

local function createPlaceablesESP(obj)
    if trackedPlaceables[obj] then return end
    if not isValidForPlaceables(obj) then return end
    local ap = getAttachPart(obj)
    if not ap then return end
    local bb = Instance.new("BillboardGui")
    bb.Name = "ESP_Placeables"
    bb.Size = UDim2.new(0, 200, 0, 30)
    bb.AlwaysOnTop = true
    bb.StudsOffset = Vector3.new(0, GlobalConfig.VerticalOffset, 0)
    bb.Enabled = PlaceablesConfig.ESPEnabled
    bb.Parent = ap
    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, 0, 1, 0)
    lb.BackgroundTransparency = 1
    lb.Text = obj.Name
    lb.TextColor3 = PlaceablesConfig.Color
    lb.TextSize = GlobalConfig.TextSize
    lb.Font = Enum.Font.SourceSansBold
    lb.TextStrokeTransparency = 0.3
    lb.TextXAlignment = Enum.TextXAlignment.Center
    lb.Parent = bb
    trackedPlaceables[obj] = {billboard = bb, label = lb}
end

local function removePlaceablesESP(obj)
    local d = trackedPlaceables[obj]
    if d then pcall(function() d.billboard:Destroy() end) trackedPlaceables[obj] = nil end
end

local function updatePlaceablesColor()
    for _, d in pairs(trackedPlaceables) do pcall(function() d.label.TextColor3 = PlaceablesConfig.Color end) end
end

local function updatePlaceablesSettings()
    for _, d in pairs(trackedPlaceables) do pcall(function()
        d.billboard.StudsOffset = Vector3.new(0, GlobalConfig.VerticalOffset, 0)
        d.billboard.Enabled = PlaceablesConfig.ESPEnabled
        d.label.TextSize = GlobalConfig.TextSize
        d.label.TextColor3 = PlaceablesConfig.Color
    end) end
end

local function scanPlaceables()
    if not PlaceablesConfig.ESPEnabled then
        for _, d in pairs(trackedPlaceables) do pcall(function() d.billboard.Enabled = false end) end
        return
    end
    local pl = workspace:FindFirstChild("Map")
    if not pl then return end
    local folder = pl:FindFirstChild("Placeables")
    if not folder then for o in pairs(trackedPlaceables) do removePlaceablesESP(o) end return end
    local cur = {}
    for _, o in ipairs(folder:GetChildren()) do if isValidForPlaceables(o) then cur[o] = true end end
    for o in pairs(cur) do if not trackedPlaceables[o] then createPlaceablesESP(o) end end
    for o in pairs(trackedPlaceables) do if not cur[o] then removePlaceablesESP(o) end end
end

local function startPlaceables() if not placeablesLoop then placeablesLoop = RunService.RenderStepped:Connect(scanPlaceables) scanPlaceables() end end
local function stopPlaceables() if placeablesLoop then placeablesLoop:Disconnect() placeablesLoop = nil end for o in pairs(trackedPlaceables) do removePlaceablesESP(o) end end

