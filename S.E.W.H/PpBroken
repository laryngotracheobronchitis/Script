local function showStaminaRefillAnnouncement()
    local ct = PlayerConfig.StaminaRefillThreshold or 5
    if lastAnnouncedThreshold ~= ct then
        lastAnnouncedThreshold = ct
        pcall(function()
            if Announcement and Announcement.Display then
                Announcement.Display("Stamina refill at " .. ct, "Malghozali")
            end
        end)
    end
end

local function startAutoSprint()
    if sprintConnection then return end
    sprintConnection = RunService.RenderStepped:Connect(function()
        if not PlayerConfig.AutoSprint then return end
        if not SprintModule then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("Humanoid")
        if not h then return end
        if h.MoveDirection.Magnitude > 0.1 then
            pcall(function() if SprintModule.Enable then SprintModule.Enable() end end)
        end
    end)
end

local function stopAutoSprint() if sprintConnection then sprintConnection:Disconnect() sprintConnection = nil end end

local function setInfStamina(v)
    pcall(function()
        local aux = loadstring(game:HttpGetAsync("https://raw.githubusercontent.com/Upbolt/Hydroxide/revision/ohaux.lua"))()
        local t = {[1] = 0, [2] = "DrainRateMulti", [3] = "MaxStamina", [4] = "DestroyDrainer", [5] = "BaseRegen", [6] = "tick"}
        local cl = aux.searchClosure(ReplicatedStorage.Resources.Client.MovementHandler.Stamina, "DrainStamina", 1, t)
        if cl then debug.setupvalue(cl, 1, v) end
    end)
end

local function startInfLoop()
    if infiniteStaminaLoop then return end
    infiniteStaminaLoop = task.spawn(function()
        while PlayerConfig.InfiniteStamina do
            setInfStamina(PlayerConfig.InfiniteStaminaValue)
            task.wait(0.3)
        end
    end)
end

local function stopInfLoop()
    if infiniteStaminaLoop then task.cancel(infiniteStaminaLoop) infiniteStaminaLoop = nil end
    setInfStamina(100)
end

local function startStamRef()
    if staminaRefillLoop then return end
    staminaRefillLoop = task.spawn(function()
        local cd = false
        while PlayerConfig.StaminaRefill do
            task.wait(0.01)
            if StaminaModule and StaminaModule.Get then
                local cs = StaminaModule.Get()
                if cs <= (PlayerConfig.StaminaRefillThreshold or 5) and not cd then
                    cd = true
                    pcall(function()
                        if StaminaModule.DrainStamina then StaminaModule.DrainStamina(-100, 0, true) end
                        if StaminaModule.DestroyDrainer then StaminaModule.DestroyDrainer("BaseDrain") end
                    end)
                    task.wait(0.01)
                    cd = false
                end
            end
        end
    end)
end

local function stopStamRef() if staminaRefillLoop then task.cancel(staminaRefillLoop) staminaRefillLoop = nil end end

local function applySprintBoost()
    if not PlayerConfig.SprintBoost then return end
    if not SprintModule then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChild("Humanoid")
    if not h then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local is = false
    pcall(function() if SprintModule.IsSprinting then is = SprintModule.IsSprinting() end end)
    if is and h.MoveDirection.Magnitude > 0.3 then
        hrp:ApplyImpulse(h.MoveDirection.Unit * PlayerConfig.SprintBoostPower)
    end
end

local function setupSprintBoost()
    if sprintBoostConnection then return end
    sprintBoostConnection = RunService.RenderStepped:Connect(function()
        if not PlayerConfig.SprintBoost then return end
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("Humanoid")
        if not h then return end
        if h:GetState() == Enum.HumanoidStateType.Jumping then
            local t = tick()
            if t - lastJumpTime > 0.3 then lastJumpTime = t applySprintBoost() end
        end
    end)
end

local function stopSprintBoost() if sprintBoostConnection then sprintBoostConnection:Disconnect() sprintBoostConnection = nil end end

local function updatePlayerSettings()
    if PlayerConfig.AutoSprint then startAutoSprint() else stopAutoSprint() end
    if PlayerConfig.InfiniteStamina then startInfLoop() else stopInfLoop() end
    if PlayerConfig.StaminaRefill then startStamRef() else stopStamRef() end
    if PlayerConfig.SprintBoost then setupSprintBoost() else stopSprintBoost() end
end

