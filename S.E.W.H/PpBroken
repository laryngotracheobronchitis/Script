local function freezeFakeTab()
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    FakeTabState.SavedCFrame = hrp.CFrame
    if FakeTabState.FreezeConnection then FakeTabState.FreezeConnection:Disconnect() end
    FakeTabState.FreezeConnection = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        if not c then return end
        local h = c:FindFirstChild("HumanoidRootPart")
        if h and FakeTabState.SavedCFrame then
            h.CFrame = FakeTabState.SavedCFrame
            h.Velocity = Vector3.new(0, 0, 0)
            h.RotVelocity = Vector3.new(0, 0, 0)
        end
    end)
    FakeTabState.Frozen = true
    if FakeTabState.IconLabel then FakeTabState.IconLabel.Text = "\u{25B6}\u{FE0F}" end
    if FakeTabState.StatusLabel then
        FakeTabState.StatusLabel.Text = "ON"
        FakeTabState.StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end
    if FakeTabState.ToggleBtn then FakeTabState.ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 90, 60) end
    if FakeTabState.BtnStroke then FakeTabState.BtnStroke.Color = Color3.fromRGB(100, 200, 100) end
    pcall(function()
        TweenService:Create(FakeTabState.ToggleBtn, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
            Size = UDim2.new(0, 55, 0, 55)
        }):Play()
        task.wait(0.2)
        TweenService:Create(FakeTabState.ToggleBtn, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            Size = UDim2.new(0, 50, 0, 50)
        }):Play()
    end)
end

local function destroyFakeTab()
    unfreezeFakeTab()
