    Title = "Enable Auto Rejoin",
    Default = false,
    Callback = function(s)
        AutoRejoinConfig.Enabled = s
        if s then setupHealthCheck()
        else
            if autoRejoinConnection then autoRejoinConnection:Disconnect() autoRejoinConnection = nil end
        end
    end
})

