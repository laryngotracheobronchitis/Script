    FakeTabState.Active = false
    FakeTabState.Gui = nil
    FakeTabState.ToggleBtn = nil
    FakeTabState.IconLabel = nil
    FakeTabState.StatusLabel = nil
    FakeTabState.BtnStroke = nil
end

