    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(100, 100, 150)
    btnStroke.Thickness = 2
    btnStroke.Transparency = 0.3
    btnStroke.Parent = toggleBtn

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(1, 0, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = "\u{23F8}\u{FE0F}"
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLabel.TextSize = 24
    iconLabel.Font = Enum.Font.SourceSansBold
    iconLabel.ZIndex = 11
    iconLabel.Parent = toggleBtn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(0, 60, 0, 20)
    statusLabel.Position = UDim2.new(0.5, -30, 1, 8)
    statusLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    statusLabel.BackgroundTransparency = 0.3
    statusLabel.BorderSizePixel = 0
    statusLabel.Text = "OFF"
    statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    statusLabel.TextSize = 11
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.ZIndex = 11
    local statusCorner = Instance.new("UICorner")
    statusCorner.CornerRadius = UDim.new(0, 6)
    statusCorner.Parent = statusLabel
    statusLabel.Parent = toggleBtn

    FakeTabState.Gui = screenGui
    FakeTabState.ToggleBtn = toggleBtn
    FakeTabState.IconLabel = iconLabel
    FakeTabState.StatusLabel = statusLabel
    FakeTabState.BtnStroke = btnStroke
    FakeTabState.Active = true

    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            FakeTabState.IsDragging = false
            FakeTabState.DragStart = input.Position
            FakeTabState.StartPos = toggleBtn.Position
        end
    end)

    toggleBtn.InputChanged:Connect(function(input)
        if FakeTabState.DragStart and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - FakeTabState.DragStart
            if delta.Magnitude > 5 then
                FakeTabState.IsDragging = true
                local newPos = UDim2.new(0, FakeTabState.StartPos.X.Offset + delta.X, 0, FakeTabState.StartPos.Y.Offset + delta.Y)
                toggleBtn.Position = clampPos(newPos, toggleBtn.AbsoluteSize)
            end
        end
    end)

    toggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not FakeTabState.IsDragging then
                if FakeTabState.Frozen then unfreezeFakeTab() else freezeFakeTab() end
            end
            FakeTabState.IsDragging = false
            FakeTabState.DragStart = nil
        end
    end)

    task.wait(0.1)
    toggleBtn.Position = UDim2.new(0.5, -toggleBtn.AbsoluteSize.X / 2, 0.5, -toggleBtn.AbsoluteSize.Y / 2)
end

