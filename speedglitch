-- Fungsi mode
local function applyAirAcceleration(character, humanoid, rootPart)
    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0 then
        lastMoveTime = tick()
        currentSpeed = currentSpeed + ACCELERATION
        local velocity = moveDir * currentSpeed
        rootPart.Velocity = Vector3.new(velocity.X, rootPart.Velocity.Y, velocity.Z)
        speedLabel.Text = string.format("%.0f", currentSpeed)
    end
end

local function applyRealistic(character, humanoid, rootPart)
    local moveDir = humanoid.MoveDirection
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local cameraRight = camera.CFrame.RightVector
    local cameraLook = camera.CFrame.LookVector
    
    if moveDir.Magnitude > 0 then
        lastMoveTime = tick()
        
        local moveAngle = math.atan2(moveDir.X, moveDir.Z)
        local cameraAngle = math.atan2(cameraLook.X, cameraLook.Z)
        local relativeAngle = moveAngle - cameraAngle
        
        local forwardInput = math.cos(relativeAngle)
        local rightInput = math.sin(relativeAngle)
        
        local forwardMove = 0
        local rightMove = 0
        
        if forwardInput < -0.5 then
            forwardMove = 1
        end
        
        if rightInput > 0.5 then
            rightMove = 1
        elseif rightInput < -0.5 then
            rightMove = -1
        end
        
        local moveVector = (cameraLook * forwardMove) + (cameraRight * rightMove)
        if moveVector.Magnitude > 0 then
            currentSpeed = currentSpeed + ACCELERATION
            moveVector = moveVector.Unit * currentSpeed
            rootPart.Velocity = Vector3.new(moveVector.X, rootPart.Velocity.Y, moveVector.Z)
            speedLabel.Text = string.format("%.0f", currentSpeed)
        end
    end
end

local function resetSpeed()
    if currentSpeed > 0 then
        currentSpeed = 0
        speedLabel.Text = "0"
    end
end

local function checkResetSpeed()
    if not speedGlitchEnabled then return end
    
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude == 0 and (tick() - lastMoveTime) >= RESET_DELAY then
        resetSpeed()
    end
end

local function startSpeedGlitch()
    if speedGlitchConnection then return end
    
    speedGlitchConnection = runService.Heartbeat:Connect(function()
        if not speedGlitchEnabled then return end
        
        local character = player.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoid or not rootPart then return end
        
        local isInAir = humanoid.FloorMaterial == Enum.Material.Air
        local badState = humanoid:GetState() == Enum.HumanoidStateType.Climbing or
                        humanoid:GetState() == Enum.HumanoidStateType.Swimming or
                        humanoid:GetState() == Enum.HumanoidStateType.Seated
        
        if isInAir and not badState then
            if MODE == "Air Acceleration" then
                applyAirAcceleration(character, humanoid, rootPart)
            else
                applyRealistic(character, humanoid, rootPart)
            end
        end
        
        checkResetSpeed()
    end)
end

local function stopSpeedGlitch()
    if speedGlitchConnection then
        speedGlitchConnection:Disconnect()
        speedGlitchConnection = nil
    end
    currentSpeed = 0
    speedLabel.Text = "0"
    lastMoveTime = 0
end

local function toggleSpeedGlitch()
    speedGlitchEnabled = not speedGlitchEnabled
    
    if speedGlitchEnabled then
        currentSpeed = 0
        lastMoveTime = tick()
        startSpeedGlitch()
        statusLabel.Text = "● ON"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        stroke.Color = Color3.fromRGB(80, 255, 100)
        stroke.Transparency = 0.2
        toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 255, 100)
        btnIcon.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    else
        stopSpeedGlitch()
        statusLabel.Text = "● OFF"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        stroke.Color = Color3.fromRGB(80, 255, 100)
        stroke.Transparency = 0.5
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        btnIcon.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleSpeedGlitch)
toggleBtn.TouchTap:Connect(toggleSpeedGlitch)

-- ===== DRAG SYSTEM =====
local dragStart = nil
local frameStart = nil
local isDragging = false

local function onDragStart(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        frameStart = mainFrame.Position
    end
end

local function onDragMove(input)
    if not isDragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and 
       input.UserInputType ~= Enum.UserInputType.Touch then return end
    
    local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
    local newPos = UDim2.new(
        frameStart.X.Scale,
        frameStart.X.Offset + delta.X,
        frameStart.Y.Scale,
        frameStart.Y.Offset + delta.Y
    )
    mainFrame.Position = newPos
end

local function onDragEnd(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        dragStart = nil
        frameStart = nil
    end
end

mainFrame.InputBegan:Connect(onDragStart)
userInputService.InputChanged:Connect(onDragMove)
userInputService.InputEnded:Connect(onDragEnd)

